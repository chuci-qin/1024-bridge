# ==============================================================================
# USDC 配置 (最简配置)
# ==============================================================================
# 只需配置以下两个 USDC 地址，其他配置会自动读取

# EVM USDC 合约地址 (Arbitrum Sepolia)
USDC_EVM_CONTRACT=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d

# SVM USDC Mint 地址 (1024Chain)
USDC_SVM_MINT=6u1x12yV2XFcEDGd8KByZZqnjipRiq9BJB2xKprhAipy

# ==============================================================================
# Decimal Ratio 配置 (可选)
# ==============================================================================
# 跨链金额转换比率。用于源链和目标链 token 精度不同的场景。
# - 相同精度 (如 6-dec USDC → 6-dec USDC): 设为 1 (默认值，无需配置)
# - 不同精度 (如 18-dec USDT → 6-dec USDC): 设为 1000000000000 (10^12)
# stake 时: 事件金额 = 源金额 / ratio
# unlock 时: 转账金额 = 事件金额 * ratio
DECIMAL_RATIO=1
