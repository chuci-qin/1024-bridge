# Build artifacts
target/
node_modules/

# Environment files (generated at runtime, never commit)
.env
.env.*
!.env.*.example
!.env.example

# Test ledger data
test-ledger/

# Relayer runtime data (generated by entrypoint.sh)
.relayer/
relayer/**/.relayer
relayer/**/.env
relayer/*.pid
relayer/logs/
relayer1/**/.relayer
relayer1/**/.env
relayer1/*.pid
relayer1/logs/

# Relayer secrets (Easypanel environment configs with private keys)
relayer/easypanel-envs/

# Mainnet env files (contain private keys)
local-debug/env-mainnet/

# IDE and editor
.cursor/

# Backup files
.backup_*

# Logs
*.log
broker/evm-gateway-service/gateway.log

# Legacy files (no longer used)
test.json
user.json
faucet-keypair.json
deploy/keys/airdrop-wallet-keypair.json
deploy/keys/admin-*
deploy1/keys/airdrop-wallet-keypair.json
deploy1/keys/admin-*
deploy1/keys/solana-program-keypair.json

# Solana keypair / wallet files (contain private keys)
solana-wallet-*.json
