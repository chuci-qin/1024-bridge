# =============================================================================
# Relayer 环境变量样例
#
# 用法：
#   cp .env.example .env
#   然后按需修改下面的值。生产环境请通过 Docker / systemd / k8s secret 注入，
#   不要把真实的 .env 提交到 git。
#
# 加载方式：
#   - 本仓库的 relayer 不内置 dotenv，请用以下任一方式加载：
#     a) 手动 `set -a; source .env; set +a; cargo run --release --bin relayer`
#     b) `env $(grep -v '^#' .env | xargs) cargo run --release --bin relayer`
#     c) docker run --env-file .env ...
#     d) systemd EnvironmentFile=/etc/relayer/.env
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# 必填：1024 链上的桥合约 Program ID + 当前所处网络
# ─────────────────────────────────────────────────────────────────────────────

# 1024 链上桥合约的 Program ID（base58 Pubkey）。
# 测试网当前部署值（参考 deploy/config/testnet/addresses.json）：
BRIDGE_1024_PROGRAM_ID=NCpy1qdBEaN6zS4EZ4jnaKuuR7VBktxmwhabS19s1YU

# 取值：mainnet | testnet | stablenet
#   mainnet   → chain_id 91024
#   testnet   → chain_id 91025
#   stablenet → chain_id 91026 （别名 "stable" 也接受）
BRIDGE_1024_NETWORK=testnet


# ─────────────────────────────────────────────────────────────────────────────
# 可选：数据持久化根目录
#
# 在该目录下会自动建出：
#   keys/         relayer 的 EVM 私钥与 SVM Keypair（首次启动自动生成，0600）
#   checkpoints/  每条链的 poller / sig enumerator 进度（block / signature）
#   events/       pending 事件文件，按 target_chain_id 分子目录
#   sigs/         SVM sig 工作队列（空文件，文件名=base58 sig，按 chain_id 分子目录）
#   sigs_dead/    SVM sig Dead Letter Queue（提取超 N 次失败的 sig，可 mv 回 sigs/ 复活）
#   logs/         每日轮转的 JSON 日志
#
# Docker 镜像默认设置为 /data 并挂载为 VOLUME；裸跑时改成本地路径。
# ─────────────────────────────────────────────────────────────────────────────
DATA_DIR=/data
# DATA_DIR=./data


# ─────────────────────────────────────────────────────────────────────────────
# 可选：日志级别（tracing EnvFilter 语法）
#
# 同时控制 stderr 与 logs/relayer.log.YYYY-MM-DD 的输出级别，二者各自独立。
# 例：
#   RUST_LOG=info
#   RUST_LOG=debug,hyper=warn,reqwest=warn
#   RUST_LOG=relayer=debug,info
# ─────────────────────────────────────────────────────────────────────────────
RUST_LOG=info


# =============================================================================
# RPC 覆盖（强烈建议主网用付费节点；不设则回退到 chain_registry 内置的公共 RPC）
#
# 命名规则： RPC_<env_name>，env_name 见 chain_registry.rs。
# =============================================================================

# ── EVM ────────────────────────────────────────────────────────────────────
# RPC_ETHEREUM_MAINNET=https://eth-mainnet.g.alchemy.com/v2/<KEY>
# RPC_ETHEREUM_SEPOLIA=https://eth-sepolia.g.alchemy.com/v2/<KEY>
# RPC_ARBITRUM_MAINNET=https://arb-mainnet.g.alchemy.com/v2/<KEY>
# RPC_ARBITRUM_SEPOLIA=https://arb-sepolia.g.alchemy.com/v2/<KEY>
# RPC_BASE_MAINNET=https://base-mainnet.g.alchemy.com/v2/<KEY>
# RPC_BASE_SEPOLIA=https://base-sepolia.g.alchemy.com/v2/<KEY>

# ── SVM ────────────────────────────────────────────────────────────────────
# RPC_SOLANA_MAINNET=https://solana-mainnet.g.alchemy.com/v2/<KEY>
# RPC_SOLANA_DEVNET=https://api.devnet.solana.com

# ── 1024 ───────────────────────────────────────────────────────────────────
# RPC_1024_MAINNET=https://rpc.1024chain.com
# RPC_1024_TESTNET=https://rpc-testnet.1024chain.com
# RPC_1024_STABLENET=https://rpc-testnet-stable.1024chain.com


# =============================================================================
# 高级调优（一般不用改，按 chain_registry.rs 内置工业标准值即可）
# =============================================================================

# ── 单链 confirmations 覆盖（reorg 容忍深度）─────────────────────────────────
# 默认值（来自 chain_registry.rs）：
#   ETH 12 / Sepolia 6 / Arbitrum 20 / Base 10
# 含义：
#   poller 只读 latest - confirmations 之前的事件；
#   submitter 等待 N 个确认才视为成功删文件。
# 例（紧急加保守）：
# EVM_CONFIRMATIONS_1=24
# EVM_CONFIRMATIONS_42161=40
# EVM_CONFIRMATIONS_8453=20

# ── 单链 stale 阈值覆盖（秒）─────────────────────────────────────────────────
# 默认值（来自 chain_registry.rs）：
#   ETH/Sepolia 600 / Arbitrum 60 / Base 120
# 含义：
#   一笔 EVM confirm tx 广播后超过 N 秒还没出 receipt，就触发
#   stale 流程（mempool 检查 → replacement 或 self-transfer 顶位）。
# 例：
# EVM_STALE_PENDING_TX_SECS_1=900
# EVM_STALE_PENDING_TX_SECS_42161=45


# =============================================================================
# 注意事项
# =============================================================================
#
# 1) Relayer 自身的私钥 / Keypair 由进程在 DATA_DIR/keys/ 下自动生成，
#    并不通过环境变量传入。首次启动后请去 ${DATA_DIR}/keys/addresses.json
#    抄出 svm_pubkey + evm_address，去桥合约把这两个地址加入 relayer 白名单
#    （否则 confirm 交易会被合约拒签）。
#
# 2) 没有出现在本文件里的环境变量都不影响 relayer 的功能。如果不确定某项
#    是否生效，搜源码中的 env::var 即可找到全部读取点。
